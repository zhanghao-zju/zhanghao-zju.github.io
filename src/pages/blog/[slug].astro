---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.default;

const categoryLabels = {
  'tech-notes': '技术学习笔记',
  'weekly-review': '学习总结',
  'lab-log': '项目实验记录',
  'life-notes': '生活碎碎念',
};

const formatDate = (date) => {
  const value = new Date(date);
  const year = value.getFullYear();
  const month = String(value.getMonth() + 1).padStart(2, '0');
  const day = String(value.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};
---

<BaseLayout title={`${post.frontmatter.title} | Blog`}>
  <article class="article">
    <p class="eyebrow">Writing</p>
    <p class="category">{categoryLabels[post.frontmatter.category]}</p>
    <h1>{post.frontmatter.title}</h1>
    <p class="meta">{formatDate(post.frontmatter.date)}</p>
    <Content />
  </article>
</BaseLayout>
