---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));
const sortedPosts = posts.sort(
  (a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf(),
);

const formatDate = (date) => {
  const value = new Date(date);
  const year = value.getFullYear();
  const month = String(value.getMonth() + 1).padStart(2, '0');
  const day = String(value.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const categories = [
  {
    key: 'tech-notes',
    title: '技术学习笔记',
  },
  {
    key: 'weekly-review',
    title: '学习总结',
  },
  {
    key: 'lab-log',
    title: '项目实验记录',
  },
  {
    key: 'life-notes',
    title: '生活碎碎念',
  },
];

const postsByCategory = categories.map((category) => ({
  ...category,
  posts: sortedPosts.filter((post) => post.frontmatter.category === category.key),
}));
---

<BaseLayout title="写作目录 | 张浩">
  <section class="hero">
    <p class="eyebrow">Writing</p>
    <h1>写作目录</h1>
  </section>

  {
    postsByCategory.map((category) => (
      <section class="section writing-section" id={category.key}>
        <h2>{category.title}</h2>
        <ul class="writing-list">
          {category.posts.map((post) => (
            <li class="writing-row">
              <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date)}</time>
              <div>
                <h3>
                  <a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a>
                </h3>
                <p>{post.frontmatter.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
