---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));
const sortedPosts = posts.sort(
  (a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf(),
);

const categories = [
  {
    key: 'tech-notes',
    title: '技术学习笔记',
    description: '记录新学到的概念、方法、工具和代码实践。',
  },
  {
    key: 'weekly-review',
    title: '每周学习总结',
    description: '按周回顾学习进度、材料、问题和下一步计划。',
  },
  {
    key: 'lab-log',
    title: '项目实验记录',
    description: '记录复现 paper、调实验、踩坑和得到的启发。',
  },
  {
    key: 'life-notes',
    title: '生活碎碎念',
    description: '更随意的生活、阅读、观察和想法片段。',
  },
];

const postsByCategory = categories.map((category) => ({
  ...category,
  posts: sortedPosts.filter((post) => post.frontmatter.category === category.key),
}));
---

<BaseLayout title="写作目录 | 张浩">
  <section class="hero">
    <p class="eyebrow">Writing</p>
    <h1>写作目录</h1>
    <p class="lead">把学习、总结、实验和生活记录放在同一个目录里，按主题分组，方便以后持续积累和检索。</p>
  </section>

  <section class="section">
    <h2>分类入口</h2>
    <div class="category-grid">
      {
        categories.map((category) => (
          <a class="category-card" href={`#${category.key}`}>
            <strong>{category.title}</strong>
            <span>{category.description}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    postsByCategory.map((category) => (
      <section class="section writing-section" id={category.key}>
        <h2>{category.title}</h2>
        <ul class="writing-list">
          {category.posts.map((post) => (
            <li class="writing-row">
              <time datetime={post.frontmatter.date}>{post.frontmatter.date}</time>
              <div>
                <h3>
                  <a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a>
                </h3>
                <p>{post.frontmatter.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
