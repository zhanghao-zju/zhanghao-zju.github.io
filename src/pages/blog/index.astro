---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  CATEGORIES,
  PAGE_SIZE,
  formatDate,
  sortPostsByDateDesc,
} from '../../lib/writing.js';

const postModules = import.meta.glob('../../content/blog/*.md', { eager: true });
const posts = Object.values(postModules);
const sortedPosts = sortPostsByDateDesc(posts);

const postsByCategory = CATEGORIES.map((category) => {
  const categoryPosts = sortedPosts.filter((post) => post.frontmatter.category === category.key);

  return {
    ...category,
    posts: categoryPosts.slice(0, PAGE_SIZE),
    totalPosts: categoryPosts.length,
    totalPages: Math.ceil(categoryPosts.length / PAGE_SIZE),
  };
});
---

<BaseLayout title="写作目录 | 张浩">
  <section class="hero">
    <h1>写作目录</h1>
  </section>

  <div class="writing-tabs" aria-label="文章专栏">
    {CATEGORIES.map((category) => <a href={`#${category.key}`}>{category.title}</a>)}
  </div>

  {
    postsByCategory.map((category) => (
      <section class="section writing-section" id={category.key}>
        <div class="writing-heading">
          <h2>{category.title}</h2>
          <span>{category.totalPosts} 篇</span>
        </div>
        {
          category.posts.length > 0 ? (
            <>
              <ul class="writing-list">
                {category.posts.map((post) => (
                  <li class="writing-row">
                    <time datetime={formatDate(post.frontmatter.date)}>
                      {formatDate(post.frontmatter.date)}
                    </time>
                    <div>
                      <h3>
                        <a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a>
                      </h3>
                    </div>
                    <span class="writing-arrow">›</span>
                  </li>
                ))}
              </ul>
              <nav class="pagination" aria-label={`${category.title}分页`}>
                <span class="disabled">上一页</span>
                <span>第 1 / {category.totalPages} 页</span>
                {category.totalPages > 1 ? (
                  <a href={`/blog/${category.key}/2/`}>下一页</a>
                ) : (
                  <span class="disabled">下一页</span>
                )}
              </nav>
            </>
          ) : (
            <p class="empty-state">暂无文章。</p>
          )
        }
      </section>
    ))
  }
</BaseLayout>
