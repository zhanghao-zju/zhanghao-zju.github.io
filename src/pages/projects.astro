---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: '个人主页与写作系统',
    summary: '基于 Astro 搭建的个人主页，支持文章分类、分页、图片资源管理和 GitHub Pages 自动部署。',
    tags: ['Astro', 'GitHub Pages', 'Markdown'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao0806/zhanghao0806.github.io' },
      { label: '线上页面', href: 'https://zhanghao0806.github.io/' },
    ],
  },
];
---

<BaseLayout title="项目 | 张浩">
  <section class="hero">
    <p class="eyebrow">Projects</p>
    <h1>项目</h1>
    <p class="lead">做过的项目、实验记录。</p>
  </section>

  <section class="section">
    <div class="card-grid">
      {
        projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-footer">
              {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
