---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: '个人主页与写作系统',
    summary: '基于 Astro 搭建的个人主页，支持文章分类、分页、图片资源管理和 GitHub Pages 自动部署。',
    tags: ['Astro', 'GitHub Pages', 'Markdown'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao-zju/zhanghao-zju.github.io' },
      { label: '线上页面', href: 'https://zhanghao-zju.github.io/' },
    ],
  },
  {
    title: 'QNN 学习笔记',
    summary: '围绕参数化量子电路、量子神经网络和相关工具链进行概念梳理与学习记录。',
    tags: ['QNN', '量子计算', '学习笔记'],
    links: [
      { label: '相关文章', href: '/blog/qnn1/' },
      { label: 'GitHub', href: 'https://github.com/zhanghao-zju' },
    ],
  },
  {
    title: '论文复现与实验记录',
    summary: '用于记录复现 paper、整理实验环境、排查问题和沉淀项目经验的长期栏目。',
    tags: ['Paper Reproduction', '实验记录', '研究方法'],
    links: [
      { label: '项目实验记录', href: '/blog/#lab-log' },
      { label: 'GitHub', href: 'https://github.com/zhanghao-zju' },
    ],
  },
];
---

<BaseLayout title="项目 | 张浩">
  <section class="hero">
    <p class="eyebrow">Projects</p>
    <h1>项目</h1>
    <p class="lead">做过的项目、实验记录。</p>
  </section>

  <section class="section">
    <div class="card-grid">
      {
        projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-footer">
              {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
