---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortPostsByDateDesc } from '../lib/writing.js';

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = sortPostsByDateDesc(Object.values(postModules));
const latestPosts = posts.slice(0, 5);
const featuredSlugs = [];
const featuredPosts = featuredSlugs.length
  ? featuredSlugs
      .map((slug) => posts.find((post) => post.frontmatter.slug === slug))
      .filter(Boolean)
  : latestPosts.slice(0, 3);
const featuredProjects = [
  {
    title: '个人主页与写作系统',
    summary: '基于 Astro 搭建的个人主页，支持文章分类、分页、图片资源管理和 GitHub Pages 自动部署。',
    tags: ['Astro', 'GitHub Pages', 'Markdown'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao-zju/zhanghao-zju.github.io' },
      { label: '线上页面', href: 'https://zhanghao-zju.github.io/' },
    ],
  },
];
const heroImage = '';
---

<BaseLayout title="张浩 | 个人主页">
  <section class="hero-panel">
    <div>
      <h1>一定要赶上和超过世界先进水平。</h1>
      <p class="lead">记录技术学习、项目实践和长期思考，把零散的输入沉淀成可复用的内容。</p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">阅读文章</a>
        <a class="button secondary" href="/projects/">查看项目</a>
      </div>
    </div>
    {
      heroImage ? (
        <img class="hero-image" src={heroImage} alt="" />
      ) : (
        <div class="hero-visual" aria-hidden="true"></div>
      )
    }
  </section>

  <section class="section">
    <div class="section-header">
      <h2>代表文章</h2>
      <a href="/blog/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredPosts.map((post) => (
          <article class="card">
            <p class="eyebrow">{formatDate(post.frontmatter.date)}</p>
            <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>代表项目</h2>
      <a href="/projects/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredProjects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-footer">
              {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/blog/">进入写作目录 →</a>
    </div>
    <ul class="writing-list">
      {
        latestPosts.map((post) => (
          <li class="writing-row">
            <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date)}</time>
            <div>
              <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
            </div>
            <span class="writing-arrow">›</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
