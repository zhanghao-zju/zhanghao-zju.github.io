---
import 'katex/dist/katex.min.css';
import CatCompanion from '../components/CatCompanion.astro';

const {
  title = '个人主页',
  description = '个人技术博客与成长记录。',
  wide = false,
} = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' },
];

const isActive = (href) => {
  if (href === '/') return Astro.url.pathname === '/';
  return Astro.url.pathname.startsWith(href);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'layout-wide': wide }}>
    <header class="site-header">
      <a class="site-title" href="/">
        <img class="site-avatar" src="/avatar.jpg" alt="" />
        <span>张浩</span>
      </a>
      <nav aria-label="主导航">
        {
          navItems.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <CatCompanion />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f8fa;
    --surface: #ffffff;
    --surface-soft: #fafbfc;
    --text: #0f172a;
    --muted: #64748b;
    --line: #e2e8f0;
    --line-strong: #cbd5e1;
    --accent: #3f5f8f;
    --accent-strong: #263f63;
    --accent-soft: #eef3f8;
    --shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    font-family:
      Inter, "Source Sans 3", "Noto Sans SC", ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    --site-shell-max-width: 1180px;
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 8% 0%, rgba(63, 95, 143, 0.08), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, var(--bg) 280px);
    color: var(--text);
    line-height: 1.72;
  }

  body.layout-wide {
    --site-shell-max-width: 1320px;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-strong);
  }

  .site-header,
  main {
    width: min(100% - 40px, var(--site-shell-max-width));
    margin: 0 auto;
  }

  @media (min-width: 1400px) {
    body.layout-wide .site-header,
    body.layout-wide main {
      margin-right: auto;
      margin-left: max(
        20px,
        calc((100% - var(--site-shell-max-width)) / 2 + 16px)
      );
    }
  }

  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 18px;
    border: 1px solid rgba(226, 232, 240, 0.78);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 14px 38px rgba(15, 23, 42, 0.07);
    backdrop-filter: blur(20px) saturate(1.18);
    -webkit-backdrop-filter: blur(20px) saturate(1.18);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 760;
    letter-spacing: 0;
  }

  .site-avatar {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 15px;
  }

  .site-header nav a {
    padding: 6px 12px;
    border-radius: 8px;
    color: var(--muted);
  }

  .site-header nav a.active,
  .site-header nav a:hover {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  main {
    padding: 42px 0 76px;
  }

  h1,
  h2,
  h3 {
    line-height: 1.22;
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
  }

  h2 {
    margin: 0;
    font-size: 24px;
  }

  h3 {
    margin: 0;
    font-size: 18px;
  }

  p {
    margin: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 760;
  }

  .lead {
    max-width: 720px;
    color: var(--muted);
    font-size: 18px;
  }

  .hero {
    display: grid;
    gap: 14px;
    margin-bottom: 34px;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    align-items: center;
    gap: 32px;
    padding: 42px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 680;
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }

  .button.secondary {
    border-color: rgba(63, 95, 143, 0.22);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .button.secondary:hover {
    border-color: rgba(63, 95, 143, 0.34);
    background: rgba(63, 95, 143, 0.14);
  }

  .hero-visual {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background:
      linear-gradient(135deg, rgba(63, 95, 143, 0.14), transparent 42%),
      linear-gradient(180deg, #ffffff, #f8fbff);
  }

  .hero-image {
    display: block;
    width: 100%;
    min-height: 260px;
    max-height: 320px;
    border: 1px solid var(--line);
    border-radius: 10px;
    object-fit: cover;
    background: var(--surface-soft);
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: 24px;
    background-image:
      linear-gradient(115deg, transparent 0 15%, rgba(63, 95, 143, 0.18) 15% 16%, transparent 16% 100%),
      linear-gradient(35deg, transparent 0 22%, rgba(63, 95, 143, 0.14) 22% 23%, transparent 23% 100%),
      radial-gradient(circle at 20% 72%, var(--accent) 0 3px, transparent 4px),
      radial-gradient(circle at 46% 44%, var(--accent) 0 3px, transparent 4px),
      radial-gradient(circle at 70% 26%, var(--accent) 0 3px, transparent 4px),
      radial-gradient(circle at 84% 58%, var(--accent) 0 3px, transparent 4px);
    opacity: 0.82;
  }

  .hero-visual::after {
    content: "";
    position: absolute;
    right: -28px;
    bottom: -28px;
    width: 280px;
    height: 180px;
    border: 1px solid rgba(63, 95, 143, 0.14);
    transform: rotate(-8deg);
    background-image:
      linear-gradient(rgba(63, 95, 143, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(63, 95, 143, 0.12) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .section {
    padding: 32px 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .section-header a {
    color: var(--muted);
    font-size: 14px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card,
  .item,
  .info-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .card,
  .item {
    padding: 20px;
  }

  .card p,
  .item p,
  .meta {
    color: var(--muted);
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    font-size: 14px;
  }

  .tag-list,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 12px 0 0;
    list-style: none;
  }

  .tag-list li,
  .tag,
  .category {
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 13px;
  }

  .writing-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .writing-tabs a {
    padding: 7px 12px;
    border-radius: 8px;
    color: var(--muted);
  }

  .writing-tabs a:hover {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .writing-section {
    scroll-margin-top: 90px;
  }

  .writing-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .writing-heading span,
  .empty-state {
    color: var(--muted);
    font-size: 14px;
  }

  .writing-list {
    overflow: hidden;
    padding: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    list-style: none;
  }

  .writing-row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) 32px;
    gap: 18px;
    align-items: center;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
  }

  .writing-row:first-child {
    border-top: 0;
  }

  .writing-row time {
    color: var(--muted);
    font-size: 14px;
  }

  .writing-row h3 {
    margin-bottom: 5px;
  }

  .writing-row p {
    color: var(--muted);
    font-size: 15px;
  }

  .writing-arrow {
    color: var(--line-strong);
    font-size: 18px;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .pagination a,
  .pagination .disabled {
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .pagination a {
    background: var(--surface);
  }

  .pagination .disabled {
    opacity: 0.55;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 16px;
  }

  .info-card {
    padding: 22px;
  }

  .info-card h2 {
    margin-bottom: 16px;
  }

  .info-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .info-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }

  .info-list strong {
    color: var(--text);
  }

  .list {
    display: grid;
    gap: 14px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (max-width: 850px) {
    .hero-panel,
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .card-grid,
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    main {
      padding: 30px 0 54px;
    }

    .hero-panel {
      padding: 24px;
    }

    .writing-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .writing-arrow {
      display: none;
    }
  }
</style>
