---
const {
  title = '个人主页',
  description = '研究生个人主页、博客与随笔。',
} = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/publications/', label: '发表' },
  { href: '/blog/', label: '写作' },
  { href: '/about/', label: '关于' },
];

const isActive = (href) => {
  if (href === '/') return Astro.url.pathname === '/';
  return Astro.url.pathname.startsWith(href);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">
        <img class="site-avatar" src="/avatar.jpg" alt="" />
        <span>张浩</span>
      </a>
      <nav aria-label="主导航">
        {
          navItems.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f4ed;
    --surface: #fffdf8;
    --text: #202124;
    --muted: #64635f;
    --line: #ded8cb;
    --accent: #1f6f78;
    --accent-strong: #174f56;
    --tag: #e7f0ed;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .site-header,
  main {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0 20px;
    border-bottom: 1px solid var(--line);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
  }

  .site-title:hover {
    text-decoration: none;
  }

  .site-avatar {
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    object-fit: cover;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 15px;
  }

  nav a {
    color: var(--muted);
  }

  nav a.active {
    color: var(--text);
    font-weight: 650;
  }

  main {
    padding: 56px 0;
  }

  .hero {
    display: grid;
    gap: 16px;
    margin-bottom: 44px;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 62px);
    max-width: 780px;
  }

  h2 {
    margin: 0 0 18px;
    font-size: 25px;
  }

  h3 {
    margin: 0 0 6px;
    font-size: 19px;
  }

  p {
    margin: 0 0 14px;
  }

  .lead {
    max-width: 720px;
    color: var(--muted);
    font-size: 19px;
  }

  .section {
    padding: 30px 0;
    border-top: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .grid > :only-child {
    grid-column: 1 / -1;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .item {
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .item p,
  .meta {
    color: var(--muted);
  }

  .category-card {
    display: block;
    min-height: 136px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
  }

  .category-card:hover {
    text-decoration: none;
    border-color: #aabbb7;
  }

  .category-card strong {
    display: block;
    margin-bottom: 8px;
    font-size: 17px;
  }

  .category-card span {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }

  .writing-section {
    scroll-margin-top: 24px;
  }

  .writing-list {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .writing-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 18px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .writing-row:first-child {
    border-top: 0;
  }

  .writing-row time {
    color: var(--muted);
    font-size: 14px;
  }

  .writing-row h3 {
    margin-bottom: 4px;
    font-size: 18px;
  }

  .writing-row p {
    margin-bottom: 0;
    color: var(--muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 4px 10px;
    background: var(--tag);
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 14px;
  }

  .list {
    display: grid;
    gap: 14px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .article {
    max-width: 760px;
  }

  .article .category {
    display: inline-flex;
    width: fit-content;
    padding: 4px 10px;
    margin: 0 0 12px;
    background: var(--tag);
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 14px;
  }

  .article :is(h2, h3) {
    margin-top: 32px;
  }

  @media (max-width: 700px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    main {
      padding: 36px 0;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .writing-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
